# VG Consultancy — Environment Variables

# Site configuration
NEXT_PUBLIC_SITE_URL=https://v-gconsultancy.com
NEXT_PUBLIC_CONTACT_EMAIL=info@vgconsultancy.com

# Recipient address for form notifications (server-side only)
CONTACT_RECIPIENT_EMAIL=info@vgconsultancy.com

# Option 1: Resend transactional email delivery (recommended)
RESEND_API_KEY=
RESEND_FROM_EMAIL=VG Consultancy <noreply@v-gconsultancy.com>

# Option 2: Generic JSON webhook (CRM / Slack / Zapier / n8n)
FORM_WEBHOOK_URL=

# Note: Copy this file to .env.local for local configuration and never commit secrets.
